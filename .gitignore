# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER COMMIT CREDENTIALS
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# AI / sandbox config
.claude
.z-ai-config
/skills

# logs
*.log
dev.log
dev.out.log
server.log

# script outputs (screenshots, downloaded artifacts)
/scripts/*.png
/scripts/*.jpg
/scripts/*.jpeg
/scripts/*.pdf
/download/

# Prisma SQLite DB
/db/*.db
/db/*.db-journal

# Sandbox / dev scaffold
/.zscripts/
/mini-services/
/examples/
/skills/
/tests/
/Caddyfile
